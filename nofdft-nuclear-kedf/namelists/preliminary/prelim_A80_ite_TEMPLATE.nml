! PRELIMINARY-CORRECTION diagnostic: A=80 KS-initialized ITE with the
! reproducible no-path shared kernel (kernels/diagnostics/eg_NP14_shared.dat,
! regenerated by 'kernel_fit.py shared_nopath'). Replace @S2@ by the gradient
! coefficient and @NMU@ by the angular quadrature (production 24; spot 48).
! 8000-step budget as in the released production cases.
&input
 run_ks=.false., run_nlf=.false., run_derivative=.false., run_teacher=.false.,
 run_deriv_check=.false., run_ite=.true., run_minimize=.false., run_diagscf=.false.,
 nlf_use_ks_density=.false., density_scale=1.0d0, external_density_file='ks_A80_nr250.dat',
 A=80, npart_q=40, kernel_mode='dd', kf_const=0.80d0,
 extra_kernel_file='', extra_g_file='kernel.dat', c_corr_shift=-1.100868d0, s2_grad_in=@S2@d0,
 qmax=60.0d0, nq=6000, nmu=@NMU@, nr_tab=4001,
 dd_xqmax_in=80.0d0, dd_ny_base_in=8001, dd_kf_scale_in=1.0d0,
 kernel_lambda=1.0d0, use_semilocal=.false.,
 ite_method='ITE_2A0', ite_init_mode='file', ite_initial_density_file='ks_A80_nr250.dat',
 ite_max_iter=8000, ite_dt=1.0d-5, ite_tol=0.0d0, ite_monitor_every=100,
 ite_dt_adapt=.true., ite_dt_max=5.0d-5, ite_dt_grow=1.1d0, ite_dt_shrink=0.5d0,
 ite_history_file='ite_history.dat', ite_density_file='ite_density.dat', ite_summary_file='ite_summary.dat'
/
