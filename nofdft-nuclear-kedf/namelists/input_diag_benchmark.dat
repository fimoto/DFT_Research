! Constant-kF ^16O benchmark: rearranged diagonalization (Table tab:diag).
! Vary diag_lambda / diag_alpha to reproduce the (lambda,alpha) rows:
!   (1,1.0) no convergence in 500; (1,0.3) 50 it; (3,1.0) 41 it; (10,1.0) 136 it.
! All converge to E = -117.1351065 MeV. The ITE comparison uses kernel_mode='const'
! with run_ite=.true., ite_dt_adapt=.false., ite_max_iter=8000 or 20000.
&input
  run_ks=.false. run_nlf=.false. run_derivative=.false. run_ite=.false.
  run_teacher=.false. run_deriv_check=.false. run_minimize=.false. run_diagscf=.true.
  nlf_use_ks_density=.false. external_density_file='ks_O16_nr250.dat'
  A=16 npart_q=8 kernel_mode='const' kf_const=0.80d0
  qmax=60.0d0 nq=6000 nmu=24 nr_tab=4001 use_semilocal=.false.
  diag_lambda=3.0d0 diag_alpha=1.0d0 diag_max_iter=500 diag_tol=1.0d-8 diag_mode='diag'
  diag_history_file='diag_l3_a1_h.dat' diag_density_file='diag_l3_a1_d.dat' diag_summary_file='diag_l3_a1_s.dat'
/
