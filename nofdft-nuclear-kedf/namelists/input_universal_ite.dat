! Shared multi-nucleus density-dependent-kF NL-OFDFT: one delta-g fit on
! {O16,Ca40,A80}, evaluated on all systems (A140 is the unseen test nucleus).
! The s2_grad=0.5 spatial-gradient term suppresses the A80 central-depletion
! artifact at nmu=24. The same delta-g and shift are used for every nucleus.
&input
  run_ks=.false. run_nlf=.false. run_derivative=.false. run_teacher=.false.
  run_deriv_check=.false. run_ite=.true. run_minimize=.false. run_diagscf=.false.
  nlf_use_ks_density=.false.
  external_density_file='ks_Ca40_nr250.dat'
  A=40 npart_q=20 kernel_mode='dd' kf_const=0.80d0
  extra_g_file='eg_UNI4.dat' c_corr_shift=0.28974d0 s2_grad_in=0.5d0
  qmax=60.0d0 nq=6000 nmu=24 nr_tab=4001 use_semilocal=.false.
  ite_method='ITE_2A0' ite_init_mode='file' ite_initial_density_file='ks_Ca40_nr250.dat'
  ite_max_iter=8000 ite_dt=1.0d-5 ite_tol=0.0d0 ite_monitor_every=50
  ite_dt_adapt=.true. ite_dt_max=5.0d-5 ite_dt_grow=1.1d0 ite_dt_shrink=0.5d0
  ite_history_file='uni_Ca40_history.dat'
  ite_density_file='uni_Ca40_density.dat'
  ite_summary_file='uni_Ca40_summary.dat'
/
