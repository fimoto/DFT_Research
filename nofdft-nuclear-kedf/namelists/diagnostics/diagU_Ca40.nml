! Rearranged-diagonalization crosscheck of the shared functional (Ca40).
! Stage kernels/universal/eg_SH14.dat as kernel.dat and the KS density.
&input
 run_ks=.false., run_nlf=.false., run_derivative=.false., run_teacher=.false.,
 run_deriv_check=.false., run_ite=.false., run_minimize=.false., run_diagscf=.true.,
 nlf_use_ks_density=.false., density_scale=1.0d0, external_density_file='ks_Ca40_nr250.dat',
 A=40, npart_q=20, kernel_mode='dd', kf_const=0.80d0,
 extra_kernel_file='', extra_g_file='kernel.dat', c_corr_shift=-2.004040d0, s2_grad_in=0.0d0,
 qmax=60.0d0, nq=6000, nmu=24, nr_tab=4001,
 dd_xqmax_in=80.0d0, dd_ny_base_in=8001, dd_kf_scale_in=1.0d0,
 kernel_lambda=1.0d0, use_semilocal=.false.,
 diag_lambda=3.0d0, diag_alpha=0.3d0, diag_max_iter=500, diag_tol=1.0d-8, diag_mode='diag',
 diag_history_file='dg_h.dat', diag_density_file='dg_d.dat', diag_summary_file='dg_s.dat'
/
