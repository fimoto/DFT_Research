! Diagnostic: O16 imaginary-time relaxation with the VALUE-ONLY fitted kernel
! (kernels/diagnostics/eg_VO14_O16.dat, shift below). Contrast figure, left/right
! "value-only endpoint" curves. Stage kernel as kernel.dat and the KS density.
&input
 run_ks=.false., run_nlf=.false., run_derivative=.false., run_teacher=.false.,
 run_deriv_check=.false., run_ite=.true., run_minimize=.false., run_diagscf=.false.,
 nlf_use_ks_density=.false., density_scale=1.0d0, external_density_file='ks_O16_nr250.dat',
 A=16, npart_q=8, kernel_mode='dd', kf_const=0.80d0,
 extra_kernel_file='', extra_g_file='kernel.dat', c_corr_shift=-0.002390d0, s2_grad_in=0.0d0,
 qmax=60.0d0, nq=6000, nmu=24, nr_tab=4001,
 dd_xqmax_in=80.0d0, dd_ny_base_in=8001, dd_kf_scale_in=1.0d0,
 kernel_lambda=1.0d0, use_semilocal=.false.,
 ite_method='ITE_2A0', ite_init_mode='file', ite_initial_density_file='ks_O16_nr250.dat',
 ite_max_iter=8000, ite_dt=1.0d-5, ite_tol=0.0d0, ite_monitor_every=20,
 ite_dt_adapt=.true., ite_dt_max=5.0d-5, ite_dt_grow=1.1d0, ite_dt_shrink=0.5d0,
 ite_history_file='ite_history.dat', ite_density_file='ite_density.dat', ite_summary_file='ite_summary.dat'
/
