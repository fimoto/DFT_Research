# Constant-kF NL-OFDFT functional derivative radial output
# rho_q is one-species density; rho_tot = 2*rho_q for N=Z SkP potential.
# mu_est[MeV] =    1.931912767708085E+02
# columns:
#  1 r[fm]
#  2 rho_q[fm^-3]
#  3 rho_tot[fm^-3]
#  4 conv = int f1(kF|r-rp|) rho_q(rp)^(5/6) d^3rp
#  5 phi=sqrt(rho_q)
#  6 lap_phi[fm^(-7/2)]
#  7 tau_TF
#  8 tau_vW
#  9 tau_NL_const_kF
# 10 NLF_NL_const_kF
# 11 v_vW=dT_vW/drho[MeV] = -C lap_phi/phi
# 12 v_kernel=dT_nonlocal_kernel/drho[MeV]
# 13 v_corr=dT_local_correction/drho[MeV]
# 14 dT_NL/drho[MeV] = v_vW+v_kernel+v_corr
# 15 v_Skyrme=dE_int/drho_tot[MeV]
# 16 dE_total/drho_q[MeV] = dT_NL/drho_q+v_Skyrme
# 17 v_eff_ITE[MeV] = v_kernel+v_corr+v_Skyrme, excluding vW kinetic operator
# 18 H_OF phi
# 19 residual_phi = H_OF phi - mu_est phi
# 20 v_SL = d T_SL^fit / drho[MeV] (zero if the semilocal fit is inactive)
