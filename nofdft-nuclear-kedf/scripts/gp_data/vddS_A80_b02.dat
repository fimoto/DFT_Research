#  1 r[fm]
#  2 rho_q[fm^-3]
#  3 rho_tot[fm^-3]
#  4 conv = int f1(kF|r-rp|) rho_q(rp)^(5/6) d^3rp
#  5 phi=sqrt(rho_q)
#  6 lap_phi[fm^(-7/2)]
#  7 tau_TF
#  8 tau_vW
#  9 tau_NL_const_kF
# 10 NLF_NL_const_kF
# 11 v_vW=dT_vW/drho[MeV] = -C lap_phi/phi
