#  1 r[fm]
#  2 rho_q[fm^-3]
#  3 rho_tot[fm^-3]
#  4 conv = int f1(kF|r-rp|) rho_q(rp)^(5/6) d^3rp
#  5 phi=sqrt(rho_q)
