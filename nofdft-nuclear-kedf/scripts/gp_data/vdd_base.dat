# 17 v_eff_ITE[MeV] = v_kernel+v_corr+v_Skyrme, excluding vW kinetic operator
# 18 H_OF phi
# 19 residual_phi = H_OF phi - mu_est phi
# 20 v_SL = d T_SL^fit / drho[MeV] (zero if the semilocal fit is inactive)
