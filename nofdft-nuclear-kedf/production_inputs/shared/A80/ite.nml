! Exact production input: shared/A80, stage 1/3 (ITE relaxation)
! Use an isolated case directory; ks.x always reads input_ks_nlf.dat.
! Requires: initial_density.dat and kernel.dat. Writes: ite_density.dat.
! Source paths and constants: production_inputs/cases.tsv
&input
 run_ks=.false., run_nlf=.false., run_derivative=.false., run_teacher=.false.,
 run_deriv_check=.false., run_ite=.true., run_minimize=.false., run_diagscf=.false.,
 nlf_use_ks_density=.false., density_scale=1.0d0, external_density_file='initial_density.dat',
 A=80, npart_q=40, kernel_mode='dd', kf_const=0.80d0,
 extra_kernel_file='', extra_g_file='kernel.dat', c_corr_shift=-2.004040d0, s2_grad_in=0.0d0,
 qmax=60.0d0, nq=6000, nmu=24, nr_tab=4001,
 dd_xqmax_in=80.0d0, dd_ny_base_in=8001, dd_kf_scale_in=1.0d0,
 kernel_lambda=1.0d0, use_semilocal=.false.,
 ite_method='ITE_2A0', ite_init_mode='file',
 ite_initial_density_file='initial_density.dat',
 ite_max_iter=8000, ite_dt=1.0d-5, ite_tol=0.0d0, ite_monitor_every=50,
 ite_dt_adapt=.true., ite_dt_max=5.0d-5, ite_dt_grow=1.1d0, ite_dt_shrink=0.5d0,
 ite_history_file='ite_history.dat', ite_density_file='ite_density.dat',
 ite_derivative_file='ite_derivative_radial.dat', ite_summary_file='ite_summary.dat',
 ite_kernel_file='ite_kernel_radial.dat'
/
